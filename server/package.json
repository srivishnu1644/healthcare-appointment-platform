{
  "name": "healthcare-appointment-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the healthcare appointment platform",
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.1"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node scripts/smoke.js",
    "test:all": "npm run test:schema && npm run test:queue && npm run test:appointments",
    "test:security": "node scripts/security-check.js",
    "test:auth": "node scripts/auth-check.js",
    "test:directory": "node scripts/directory-check.js",
    "test:slots": "node scripts/slot-check.js",
    "test:appointments": "node scripts/appointment-check.js",
    "test:queue": "node scripts/queue-check.js",
    "test:flow": "node scripts/doctor-flow-check.js",
    "test:schema": "node src/db/scripts/verify-schema.js",
    "db:local": "node scripts/local-postgres.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:status": "node src/db/migrate.js --status",
    "db:migrate:reset": "node src/db/migrate.js --reset",
    "db:seed": "node src/db/seed.js",
    "db:import:json": "node src/db/scripts/migrate-json.js",
    "db:import:json:status": "node src/db/scripts/migrate-json.js --status",
    "db:purge-sessions": "node scripts/purge-sessions.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
