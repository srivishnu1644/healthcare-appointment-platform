# ============================================================
#  MediCare API — environment template
#  Copy to `.env` and fill in real values.
#
#     cp server/.env.example server/.env
#
#  NEVER commit a real .env. It is ignored by .gitignore.
#  The only file that belongs in version control is this one.
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database (REQUIRED) ----------
# Supabase PostgreSQL. This is the ONLY place database credentials belong —
# they are read from the environment and are never committed.
#
# Supabase Project Settings -> Database -> Connection string -> URI
#   Use the *Session Pooler* (port 5432) for migrations and the app.
#   Use the *Transaction Pooler* (port 6543) only for very high concurrency;
#   it does not support session state such as LISTEN/NOTIFY or temporary
#   tables.
#
#   Supabase (session pooler):
#     DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
#   Local PostgreSQL:
#     DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/medicare
#
#   Bundled local server (`npm run db:local`, no install needed):
#     DATABASE_URL=postgresql://postgres@localhost:5433/postgres
#
# The server REFUSES TO START if this is missing or unreachable, so a
# misconfigured deployment fails loudly instead of serving broken responses.
DATABASE_URL=

# TLS. Leave this UNSET to get the safe default: TLS is required for any
# non-loopback host (which is every Supabase connection string) and disabled
# for 127.0.0.1 / localhost, where a local server offers no certificate.
# Setting it to `true` alongside a localhost URL will fail the handshake.
# DB_SSL=true

# Connection pool size. 10 suits Supabase; the bundled local server
# serialises queries and needs 1.
DB_POOL_MAX=10

# Discrete connection settings, used only when DATABASE_URL is empty.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=medicare
# DB_USER=postgres
# DB_PASSWORD=

# Business/display timezone. Stored timestamps are absolute instants; the
# `date` / `startTime` / `endTime` strings the API returns are derived in this
# zone. Change it only before importing data — existing rows keep their
# original local-time interpretation.
APP_TIMEZONE=Asia/Kolkata

# Path to the legacy JSON datastore, read ONLY by the one-time migration
# script (`npm run db:import:json`). The application runtime does not touch it.
JSON_DATA_PATH=.data/db.json

# ---------- Session tokens ----------
# JWT_SECRET is used to sign ACCESS tokens only.
#
#   * The server REFUSES TO START outside `test` if this is missing.
#   * Generate a strong random value:
#       node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   * Rotating this value invalidates every issued access token.
JWT_SECRET=

# Access-token lifetime. Deliberately SHORT: it is a stateless bearer token
# that cannot be revoked, so its value is bounded by how long it lives. The
# refresh token below is the long-lived credential.
# Accepts a duration string ("15m", "900s", "1h") or a raw second count.
JWT_EXPIRES_IN=15m

# Refresh-token lifetime in days. A refresh token is stored only as a SHA-256
# digest, rotated on every use, and revoked outright if a spent one is
# replayed — so a longer lifetime is comparatively low risk.
REFRESH_TOKEN_TTL_DAYS=30

# Claim issuer recorded in, and required from, access tokens.
JWT_ISSUER=medicare-api

# ---------- CORS (REQUIRED in production) ----------
# REQUIRED in production. In development it defaults to the Vite dev server.
# Comma-separated list of allowed origins — no wildcards, no `*`.
#   development: http://localhost:5173
#   production : https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---------- Password hashing ----------
# bcrypt cost factor. 10-12 for production. Lower is faster but weaker.
# Demo development only; leave unset to use the default.
BCRYPT_ROUNDS=10

# ---------- Google Gemini (optional) ----------
# When unset, the built-in rule-based triage engine is used instead.
GEMINI_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Twilio SMS (optional) ----------
# When unset, notifications are logged to the console instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Resend email (optional) ----------
# When unset, notifications are logged to the console instead of being sent.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@medicare.demo