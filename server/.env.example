# ============================================================
#  BookMyDoc API — environment template
#  Copy to `server/.env` and fill in the required values.
#  Boot fails loudly on a missing/unreachable database or JWT_SECRET.
#
#  Fresh database?  npm run db:schema   (applies supabase/schema.sql)
#  Then demo data?  npm run db:seed
#  See supabase/README.md for hosted PostgreSQL.
# ============================================================

NODE_ENV=development
PORT=5000

# ---------- Database (REQUIRED) ----------
# Supabase: Project Settings -> Database -> Connection string.
# Use the Session Pooler string (port 5432), and percent-encode
# special characters in the password (@ -> %40):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Any local PostgreSQL:
#   postgresql://postgres@localhost:5432/postgres
# TLS is automatic for any non-localhost host.
DATABASE_URL=

# Connections held per process. Keep low on a small instance; the
# scheduler and each in-flight request need one.
DB_POOL_MAX=10

# The clinic's business day. Every date and time the API returns is
# derived here, so a daylight-saving boundary never moves an appointment.
APP_TIMEZONE=Asia/Kolkata

# ---------- Session tokens (REQUIRED) ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be >= 32 characters. Rotating it invalidates every issued token,
# and a production boot refuses a short or known-placeholder value.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------- CORS (REQUIRED in production) ----------
# Comma-separated allowed origins. No wildcards; a production boot
# without this variable is fatal.
CORS_ORIGIN=http://localhost:5173

# ---------- Optional integrations ----------
# Unset means a safe local fallback, never a crash.

# Gemini — without it the assistant answers from a reviewed knowledge
# base and symptom triage is unavailable.
GEMINI_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Twilio SMS — without it, messages are logged to the console and the
# API reports channels.simulated so the UI can say so honestly.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend email — same fallback as Twilio.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@bookmydoc.demo

# ---------- Optional tuning ----------
# Password hashing cost. Lower it only in development.
# BCRYPT_ROUNDS=12

# How often the in-process reminder sweep runs, and the assistant's
# per-minute cap (AI calls cost money upstream).
# NOTIFICATION_SWEEP_MINUTES=15
# ASSIST_MAX_PER_MINUTE=60

# Set to 1 to stop the background scheduler. Required on all but one
# instance if you ever run more than one API process.
# DISABLE_SCHEDULER=1
