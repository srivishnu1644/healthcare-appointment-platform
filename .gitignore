# ---------- dependencies ----------
node_modules/
.npm/
.pnp
.pnp.js

# ---------- build output ----------
# Regenerate with `npm --prefix client run build`. The API serves this
# directory in production, so it is built on the host, not committed.
dist/
build/

# ---------- environment / secrets ----------
# Real values only. The two .env.example templates are tracked.
.env
.env.*
!.env.example

# ---------- logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- test / coverage output ----------
coverage/
.nyc_output/

# ---------- tooling caches ----------
.cache/
.vite/
.eslintcache

# ---------- documentation ----------
# Long-form reference material kept for local reading, not published.
# The schema itself is NOT ignored - that is part of the project.
docs/

# ---------- browser-automation output ----------
# UI walkthrough screenshots. Not part of the application.
recordings/
playwright-report/
test-results/

# ---------- editor / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
# Swap and backup files left behind by an interrupted edit.
*.swp
*.swo
*~
*.orig
*.rej

# ---------- misc ----------
*.pid
*.seed
