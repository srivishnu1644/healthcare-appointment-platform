# ============================================================
#  BookMyDoc web client — environment template
#  Copy to `client/.env`, then restart the dev server.
#
#  Vite inlines VITE_* values into the built bundle at BUILD time, so
#  anything here is PUBLIC. Never put a server-side secret in this file.
# ============================================================

# API base URL. Leave EMPTY in development: the Vite dev server proxies
# /api to the API, so there is no CORS. Set it in production, and rebuild
# to change it — it is baked in at build time, not read at runtime:
#   VITE_API_URL=https://your-api.example.com/api
VITE_API_URL=
