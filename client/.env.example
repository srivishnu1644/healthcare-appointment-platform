# ============================================================
#  MediCare web client — environment template
#  Copy to `.env` and fill in real values.
#
#     cp client/.env.example client/.env
#
#  Vite inlines VITE_* values into the built JavaScript bundle at BUILD time.
#  Anything exposed this way is PUBLIC. Never put a server-side secret here.
# ============================================================

# ---------- API base URL ----------
# Development: the Vite dev server proxies /api to the API (see vite.config.js),
# so leave this EMPTY to use the proxy and keep the browser on one origin.
#
# Production: point at the deployed API. Example:
#   VITE_API_URL=https://medicare-api.onrender.com/api
VITE_API_URL=

# ---------- Supabase (Phase 2 — not yet used) ----------
# Placeholder only. No Supabase client is installed or imported at this stage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=